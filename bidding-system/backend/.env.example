DATABASE_URL=sqlite+aiosqlite:///./bidding.db
REDIS_URL=redis://localhost:6379/0

# AES-256-GCM key (32-byte base64url)
# 생성: python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# 나라장터 OpenAPI (data.go.kr 발급)
G2B_API_KEY=

# JWT
JWT_SECRET=change-this-in-production-use-random-32-chars
JWT_EXPIRE_MINUTES=1440

# 최초 관리자 계정 (기동 시 없으면 자동 생성)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# Slack 알림
SLACK_WEBHOOK_URL=

# AWS SES 이메일
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_REGION=ap-northeast-2
NOTIFICATION_EMAIL_FROM=noreply@example.com

# 카카오 알림톡
KAKAO_API_KEY=
KAKAO_SENDER_KEY=
KAKAO_TEMPLATE_CODE=

# OpenAI (서류 AI 생성)
OPENAI_API_KEY=

CRAWL_INTERVAL_MINUTES=30
